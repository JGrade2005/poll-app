# Copy this file to .env.local and fill in the two values.
#
# Where to find them: open your project at https://supabase.com/dashboard and
# click "Connect" at the top (or go to Project Settings -> API Keys).
#
#   VITE_SUPABASE_URL             = Project URL, e.g. https://abcdefghijklmnop.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY = Publishable key, starts with sb_publishable_
#
# Both values are PUBLIC by design (they ship to the browser).
# Data is protected by Row Level Security, not by hiding these values.
# NEVER put a secret key (sb_secret_...), the legacy service_role key,
# or the database password here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: base URL used in QR codes. Defaults to the URL the app is served from.
# Set this if you present from a different host than students should use.
# VITE_PUBLIC_SITE_URL=https://poll-app.your-subdomain.workers.dev
