// Cloudflare Workers deployment config (Workers Builds runs `npx wrangler deploy`).
// "name" must match the Worker's name in the Cloudflare dashboard.
// The site is static: Vite builds it into ./dist and Cloudflare serves those files.
// "single-page-application" returns index.html for unknown paths, so links like
// /s/abc12345 and /dashboard work when opened directly or refreshed.
{
  "name": "poll-app",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
